# =============================================================================
# Envosta — environment variables
#
# Copy this file to `.env.local` for local dev. Production values live in
# Vercel project settings. ALL of these are required to be set in
# production — missing CRON_SECRET, INTERNAL_API_TOKEN, or RESEND_API_KEY
# silently degrades critical flows.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...                          # service-role key

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...                              # sk_live_... in prod
STRIPE_WEBHOOK_SECRET=whsec_...                            # from Stripe webhook config
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...             # pk_live_... in prod

# -----------------------------------------------------------------------------
# wp.cloud (Atomic) hosting
# -----------------------------------------------------------------------------
WPCLOUD_API_KEY=                                           # platform-level API key
WPCLOUD_CLIENT=envosta
WPCLOUD_BASE_URL=https://atomic-api.wordpress.com          # leave default

# -----------------------------------------------------------------------------
# OpenSRS (domain registrar)
# -----------------------------------------------------------------------------
OPENSRS_USERNAME=
OPENSRS_API_KEY=
OPENSRS_HOST=https://rr-n1-tor.opensrs.net:55443           # live endpoint

# -----------------------------------------------------------------------------
# Internal API (server-to-server token)
# -----------------------------------------------------------------------------
# Shared secret required by callers of /api/internal/*. Long random string
# (>=32 chars). The verifyInternalToken() helper fails closed if unset.
INTERNAL_API_TOKEN=

# -----------------------------------------------------------------------------
# Cron auth
# -----------------------------------------------------------------------------
# Vercel attaches this as Authorization: Bearer ${CRON_SECRET} on every
# cron-fired request. All 9 cron routes fail-closed if unset.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Resend API key. Without this, transactional + admin alert emails silently
# don't send. Both `noreply@email.envosta.com` and `hello@email.envosta.com`
# must be verified domains in your Resend account — noreply@ is used for
# system emails (welcome, payment failed, alerts) and hello@ is used for
# customer-facing notices (site deletion warning).
RESEND_API_KEY=re_...

# Where the drift-alerter + health-check + sales notification emails are sent.
# Defaults to sales@envosta.com if unset (rate-limit + contact form go there
# regardless).
ADMIN_ALERT_EMAIL=admin@envosta.com

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://my.envosta.com                 # customer dashboard host
NEXT_PUBLIC_SITE_URL=https://envosta.com                   # marketing host

# -----------------------------------------------------------------------------
# Tunables
# -----------------------------------------------------------------------------
# How many days before a domain expires we start trying to renew it via the
# daily cron. Default 7. Lower = more attempts before expiry; higher = earlier.
DOMAIN_RENEWAL_WINDOW_DAYS=7

# Optional: parent-theme zip download URL used by provisioning. Leave unset
# unless you have a custom parent theme to install on every new site.
ENVOSTA_PARENT_THEME_ZIP_URL=
